# Copy this file to .env for local work: cp .env.example .env
# On the VM, deploy/setup_vm.sh writes /srv/nexora/app/.env with production values (systemd reads it).

# --- Flask ---
# Turns on auto-reload and the debugger for `flask run`. Never set on the VM.
FLASK_DEBUG=1
# Signs session cookies. Any value locally; on the VM it comes from Secret Manager.
SECRET_KEY=change-me-to-any-long-random-text
# Where SECRET_KEY comes from: env (this file) or secret_manager (VM).
SECRET_SOURCE=env
# Name of the secret in Secret Manager. Only used when SECRET_SOURCE=secret_manager.
SECRET_NAME=nexora-secret-key
# true only behind HTTPS (the VM). Locally false, or logins won't stick on http://.
SESSION_COOKIE_SECURE=false

# --- Database ---
# Relative SQLite paths live in the instance/ folder, so this is instance/nexora.db.
# VM: sqlite:////srv/nexora/data/nexora.db  (four slashes = absolute path)
DATABASE_URL=sqlite:///nexora.db

# --- Logging ---
# Empty = JSON logs to the terminal only. VM: /var/log/nexora/app.log
LOG_FILE=
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# --- Time ---
# "Today", exam dates and streaks use this time zone. Stored times are UTC.
APP_TIMEZONE=Asia/Kolkata

# --- AI ---
# false = realistic fake data, no GCP needed. true = real Gemini on Vertex AI.
AI_ENABLED=false
# Gemini Flash model name on Vertex AI. gemini-3.5-flash is confirmed in "global" (2 Oct 2026);
# the thinking levels in ai_service.py were tuned on it.
GEMINI_MODEL=gemini-3.5-flash
# AI calls each student may make per day. Cached Explain doesn't count.
AI_DAILY_LIMIT=20
# Seconds before a Gemini call gives up.
AI_TIMEOUT_SECONDS=15

# --- Note photos ---
# local = save under instance/uploads/. gcs = save to NOTES_BUCKET.
STORAGE_BACKEND=local
# Empty = instance/uploads. Only used when STORAGE_BACKEND=local.
UPLOAD_FOLDER=

# --- Google Cloud (only needed on the VM) ---
# Project id, e.g. nexora-recall-123456.
GCP_PROJECT=
# Where Vertex AI runs Gemini. "global" lets Google pick a region with capacity;
# use us-central1 if a model isn't offered globally.
GCP_LOCATION=global
# Private bucket for note photos (7-day delete rule).
NOTES_BUCKET=
# Private bucket for nightly database backups.
BACKUP_BUCKET=
# BigQuery dataset for the nightly reviews export.
BQ_DATASET=nexora
